# Gemini (principal). Deixe vazio para usar somente o Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LLM fallback (Ollama). Com Docker Compose + profile local-llm:
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Embeddings / chunking
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_TOKENS=420
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=6

# Infraestrutura
POSTGRES_DB=onboardia
POSTGRES_USER=onboardia
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql+psycopg://onboardia:change-this-db-password@postgres:5432/onboardia
REDIS_URL=redis://redis:6379/0

# URLs internas dos serviços
API_INTERNAL_URL=http://api:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_KEY=change-this-to-a-long-random-secret
API_CORS_ORIGINS=http://localhost:3000

# Aplicação
UPLOAD_DIR=/app/storage
MAX_UPLOAD_MB=25
WORKER_CONCURRENCY=2
